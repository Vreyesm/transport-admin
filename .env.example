NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Privada: conexión PostgreSQL del mismo proyecto, solo para migraciones.
# Usa el puerto directo o el session pooler, no el transaction pooler.
SUPABASE_DB_URL=
# Contraseña PostgreSQL (puede omitirse si ya está codificada en SUPABASE_DB_URL).
SUPABASE_DB_PASSWORD=
