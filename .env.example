POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
COOKIE_SECURE=false
PORT=3000
# Desarrollo fuera de Docker; PostgreSQL debe ser accesible en esta dirección.
DATABASE_URL=postgres://transport:replace-with-a-long-random-alphanumeric-password@localhost:5432/transport

# URL publica exacta si se usa proxy, por ejemplo https://transport.example.cl
APP_ORIGIN=
